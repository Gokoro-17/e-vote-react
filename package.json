{
  "name": "e-vote-react",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.server.json",
    "test": "tsx --test --test-concurrency=1 server/engine.test.ts server/platform.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/apply-supabase.mjs",
    "admin:bootstrap": "tsx server/bootstrap-admin.ts",
    "security:scan": "npm audit --omit=dev",
    "db:backup": "tsx server/backup.ts",
    "db:restore": "tsx server/backup.ts",
    "test:live": "tsx scripts/live-readiness.ts",
    "format": "prettier --write src server scripts/*.ts README.md docs index.html",
    "worker:once": "tsx server/worker.ts",
    "auth:check": "node scripts/check-auth-settings.mjs",
    "storage:setup": "node scripts/setup-storage.mjs",
    "billing:setup": "tsx scripts/setup-billing.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "1.50.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pdfkit": "^0.20.2",
    "pg": "8.23.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sharp": "0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "prettier": "3.8.3",
    "supabase": "2.119.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}

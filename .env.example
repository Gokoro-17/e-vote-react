# Copy this file to .env and fill your own project credentials privately.
# Secrets belong on the API host, never in VITE_* variables or source control.
SUPABASE_URL=https://mdtymdvybaurguflwktt.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# From Supabase Connect: use a session pooler or direct PostgreSQL connection.
# Include the database password, not an API key. DIRECT_URL must use port 5432.
# Replace the entire [YOUR-PASSWORD] placeholder, including brackets; URL-encode reserved password characters.
DATABASE_URL=
DIRECT_URL=
# Optional CA certificate downloaded from Supabase Database settings.
SUPABASE_CA_CERT_PATH=
APP_ORIGIN=http://localhost:5174
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=0
NODE_ENV=development
# Separate random 32-byte base64 values. Never reuse one key for both purposes.
DATA_ENCRYPTION_KEY=
BALLOT_ENCRYPTION_KEY=
# Application notifications (Supabase Auth SMTP is configured in its dashboard).
SMTP_URL=
MAIL_FROM=
CONTACT_EMAIL=
# Dedicated random bearer secret for the Supabase Cron maintenance endpoint.
WORKER_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
REQUIRE_VOTE_CAPTCHA=false
SUSPICIOUS_VOTES_PER_HOUR=500
ENABLE_PHONE_VERIFICATION=false
# Real, explicitly authorized provider. No fake provider or government registry.
IDENTITY_PROVIDER_URL=
IDENTITY_PROVIDER_TOKEN=
PG_DUMP_PATH=
PG_RESTORE_PATH=
RECOVERY_DATABASE_URL=
LIVE_TEST_ORIGIN=http://127.0.0.1:3001
# Paystack live secret key stays on the server. Amounts are defined in shared/plans.ts.
PAYSTACK_SECRET_KEY=
# Filled automatically by npm run billing:setup once the secret key is configured.
PAYSTACK_PLAN_PRO=
PAYSTACK_PLAN_BUSINESS=
PAYSTACK_PLAN_ENTERPRISE=
